# ROS 2 / colcon output
/build/
/install/
/log/

# Keep generated output out of nested package checkouts as well.  Existing
# tracked files remain tracked, but new build products are ignored.
build/
install/
log/
cmake-build-*/
CMakeFiles/
CMakeCache.txt
cmake_install.cmake
CTestTestfile.cmake
Makefile
compile_commands.json
Testing/
_deps/
.colcon/
.colcon_ignore
COLCON_IGNORE
AMENT_IGNORE
devel/
build_isolated/
devel_isolated/
.obj-x86_64-linux-gnu/
logs/

# C/C++ compiler and linker products (the checked-in SDK libraries are kept
# because .gitignore never affects files that are already tracked).
*.d
*.o
*.obj
*.lo
*.la
*.a
*.so
*.so.*
*.dylib
*.dll
*.gch
*.pch
*.exe
*.out
*.app

# External SDK checkouts.  They are read-only siblings of this repository;
# these entries also protect against accidentally cloning one into the tree.
/Dexterous-Hand/
/OrbbecSDK_ROS2/

# Common ROS recording output
*.bag
*.bag.active
*.db3
*.mcap
rosbag2_*/
.ros/
*.log
*.pcd

# ROS 1/ROS 2 generated interface and package markers
msg/*Action.msg
msg/*ActionFeedback.msg
msg/*ActionGoal.msg
msg/*ActionResult.msg
msg/*Feedback.msg
msg/*Goal.msg
msg/*Result.msg
msg/_*.py
srv/_*.py
*.cfgc
CATKIN_IGNORE

