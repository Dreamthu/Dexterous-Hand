# Local overrides and crash output
config/*.local.env
.env
.env.*
!.env.example
*.local
*.core
core.*
nohup.out

# Offline datasets and replay output (may contain private camera images).
/artifacts/offline_detection/
/artifacts/datasets/

# Teaching materials (not part of the competition project)
/teaching/
