venv/
ENV/
env.bak/
venv.bak/
.ipynb_checkpoints/
.pyre/
.pytype/
cython_debug/
*$py.class
.dmypy.json
dmypy.json
.pdm.toml
__pypackages__/
.ropeproject/
.spyderproject
.spyproject

