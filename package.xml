  <description>Standalone fixed-camera eye-to-hand calibration using a right-wrist ArUco board.</description>
  <maintainer email="maintainer@example.invalid">LinkerBot competition team</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
